{
  "name": "dsh-open-in-xyz",
  "version": "0.2.5",
  "description": "Local DeepSeek Harness plugin: open the current Session workspace in XYZ from the conversation header.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/xyz-icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/*.png",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --check index.js && node --check client.js && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
