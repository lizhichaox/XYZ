<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Export options for a Developer ID build. `xcodebuild -exportArchive` re-signs
     the archived app with the Developer ID Application certificate and adds the
     direct-distribution provisioning profile. See docs/release.md. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>developer-id</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>Z4FMG2KTPM</string>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
